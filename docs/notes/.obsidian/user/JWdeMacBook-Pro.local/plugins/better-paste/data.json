{
  "autoClean": true,
  "listNesting": true,
  "quoteContinuation": true,
  "showReleaseNotes": true,
  "fileMode": "off",
  "imageMode": "download",
  "imageNameTemplate": "{{name}}",
  "imageSizeOptions": "200, 400, 600",
  "imageSizeChoice": "",
  "imageClassOptions": "",
  "imageClassChoice": "",
  "imageLastSize": "",
  "imageLastClass": "",
  "noteProperty": "bp",
  "imageSizeProperty": "image-width",
  "linkEnabled": true,
  "linkTitles": true,
  "linkTitleFallback": "off",
  "linkRemovals": [],
  "textTrim": true,
  "textInvisible": true,
  "textQuotes": false,
  "textDashes": false,
  "textSnippets": [
    {
      "id": "0iyfhz5",
      "name": "移除标题中的加粗",
      "rules": [
        "s/(?<=^#{1,6} [^\\n]*?)(?<!\\\\)\\*\\*([^\\n]*?)(?<!\\\\)\\*\\*/$1/gm"
      ],
      "enabled": true
    },
    {
      "id": "00633m6",
      "name": "合并空行",
      "rules": [
        "s/\\n(?:[ \\t]*\\n){2,}/\\n\\n/g"
      ],
      "enabled": true
    },
    {
      "id": "0iglihw",
      "name": "Remove bold from headings",
      "rules": [
        "# Remove bold from headings",
        "s/^(#{1,6} .*?)(?<!\\\\)\\*\\*([^\\n]*?)(?<!\\\\)\\*\\*/$1$2/gm"
      ],
      "enabled": true
    },
    {
      "id": "1wtfi0v",
      "name": "Convert ChatGPT math to dollar math",
      "rules": [
        "# Convert ChatGPT math to dollar math",
        "",
        "# Block math to $$ ... $$",
        "s/\\\\\\[([\\s\\S]*?)\\\\\\]/$$$$$1$$$$/g",
        "",
        "# Inline math to $ ... $",
        "s/\\\\\\(([\\s\\S]*?)\\\\\\)/$$$1$$/g"
      ],
      "enabled": true
    }
  ],
  "urlSnippets": [
    {
      "id": "1ijqubk",
      "name": "移除页面标题中的网站名称",
      "rules": [
        "s#^\\[GitHub - ([^\\]]+) · GitHub\\](\\(https://github\\.com/\\S+\\))$#[$1]$2#",
        "s#^\\[([^\\]]+) · GitHub\\](\\(https://github\\.com/\\S+\\))$#[$1]$2#",
        "s#^\\[(.+) - YouTube\\](\\(https://(?:www\\.|m\\.)?(?:youtube\\.com|youtu\\.be)/\\S+\\))$#[$1]$2#",
        "s#^\\[(.+) : r/[^\\s\\]]+\\](\\(https://(?:www\\.|old\\.)?reddit\\.com/\\S+\\))$#[$1]$2#",
        "s#^\\[(.+) [-–—] [^\\]]+\\](\\(https://[a-z-]+\\.(?:m\\.)?wikipedia\\.org/\\S+\\))$#[$1]$2#"
      ],
      "enabled": true
    }
  ],
  "lastShownVersion": "1.0.17",
  "pdfLastFurniture": true,
  "pdfLastSingleParagraph": false
}